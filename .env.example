# ═══════════════════════════════════════════════════════════════════════════
# WallStack SRE Lab · .env.example
# ───────────────────────────────────────────────────────────────────────────
# Пример переменных окружения.
# Скопируй в .env и подставь реальные значения.
#
# ВАЖНО: .env — в .gitignore. НЕ коммитится.
# Это только ШАБЛОН с фейковыми значениями.
#
# Создано: 2026-10-10
# ═══════════════════════════════════════════════════════════════════════════

# ─── Приложение ───
# Окружение: development | staging | production
APP_ENV=development

# Режим отладки: true | false
APP_DEBUG=true

# Порт приложения
APP_PORT=8000

# Базовый URL (для генерации ссылок)
APP_BASE_URL=http://localhost:8000

# Секретный ключ приложения (сгенерировать: openssl rand -hex 32)
APP_SECRET_KEY=change-me-please-use-openssl-rand-hex-32

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── PostgreSQL ───
# Host: localhost для local, имя сервиса для docker-compose
POSTGRES_HOST=localhost

# Port: 5432 — стандарт
POSTGRES_PORT=5432

# Database name
POSTGRES_DB=wallstack_sre_lab

# User
POSTGRES_USER=wallstack

# Password (для реального — сгенерировать: openssl rand -hex 16)
POSTGRES_PASSWORD=change-me-in-production

# Полный URL подключения (можно использовать вместо отдельных переменных)
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://wallstack:change-me-in-production@localhost:5432/wallstack_sre_lab

# ─── Redis (кэш, опционально) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT / Аутентификация ───
# Секрет для JWT-токенов (сгенерировать: openssl rand -hex 32)
JWT_SECRET=change-me-please-use-openssl-rand-hex-32

# Время жизни токена в секундах (3600 = 1 час)
JWT_EXPIRES_IN=3600

# Алгоритм подписи JWT
JWT_ALGORITHM=HS256

# ─── API-ключи ───
# Соль для хэширования API-ключей
API_KEY_SALT=change-me-please

# Максимальное количество активных API-ключей на пользователя
API_KEY_MAX_PER_USER=5

# ─── S3 / Object Storage (позже в курсе) ───
S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-1
S3_BUCKET=wallstack-sre-lab
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_USE_SSL=true

# ─── Observability (Фаза 4) ───
# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Loki (логи)
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100

# OpenTelemetry (трейсинг)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=wallstack-sre-lab

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ─── CORS ───
# Разрешённые origins (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Nginx (Фаза 3) ───
NGINX_SERVER_NAME=lab.wallstackaudio.com
NGINX_SSL_ENABLED=false

# ─── Terraform / Cloud (Фаза 3) ───
# Timeweb Cloud
TIMEWEB_TOKEN=change-me-timeweb-api-token
TIMEWEB_REGION=msk1

# ─── CI/CD (Фаза 2+) ───
# GitHub Actions (не нужны в .env — используются через secrets)
# GITHUB_TOKEN — добавляется в Settings → Secrets

# ─── Уведомления (Фаза 4) ───
# Slack webhook для алертов (опционально)
SLACK_WEBHOOK_URL=

# Email для алертов (опционально)
ALERT_EMAIL=origin@wallstackaudio.com

# ─── Разработка ───
# Включить hot-reload
DEV_RELOAD=true

# Показывать SQL-запросы в логах
DEV_SHOW_SQL=false

# ─── End of .env.example ───